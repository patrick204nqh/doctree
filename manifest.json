{
  "manifest_version": 3,
  "name": "Doctree",
  "version": "1.2.0",
  "minimum_chrome_version": "102",
  "description": "Browse a local folder as a tree and read Markdown, HTML, JSON, CSV and source files in the browser",
  "homepage_url": "https://github.com/patrick204nqh/doctree",

  "sandbox": {
    "pages": ["viewer/html-frame.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-popups allow-popups-to-escape-sandbox; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; object-src 'self'"
  },

  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "file://*"
  ],

  "action": {
    "default_title": "Doctree"
  },

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "content_scripts": [
    {
      "matches": ["file://*"],
      "js": ["content/content_script.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "viewer/viewer.html",
        "viewer/viewer.js",
        "viewer/core.js",
        "viewer/state.js",
        "viewer/dom.js",
        "viewer/settings.js",
        "viewer/outline.js",
        "viewer/palette.js",
        "viewer/tree.js",
        "viewer/crumbs.js",
        "viewer/folders.js",
        "viewer/reader.js",
        "viewer/viewer.css",
        "viewer/theme.js",
        "libs/marked.min.js",
        "libs/highlight.min.js",
        "libs/purify.min.js",
        "libs/mermaid.min.js"
      ],
      "matches": ["file://*", "chrome-extension://*/*"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
